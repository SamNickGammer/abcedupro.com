# ---------------------------------------------------------------- database
# Neon Postgres. The pooled URL is what the app uses at runtime; the unpooled
# (direct) URL is what `prisma migrate` needs, because migrations run DDL that
# a connection pooler cannot proxy.
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# ---------------------------------------------------------------- auth
# Signs the session cookie. Regenerate with: openssl rand -base64 48
AUTH_SECRET=""
# Session lifetime in seconds (default 12h).
AUTH_SESSION_TTL=43200

# ---------------------------------------------------------------- storage
# Cloudflare R2 (S3-compatible). See docs/R2_SETUP.md for where each value comes from.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="abcedupro"
# Public base URL for the bucket: either the r2.dev dev subdomain or your own
# custom domain (e.g. https://cdn.abcedupro.com). No trailing slash.
R2_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------- app
# Absolute origin, used to build certificate verification URLs and QR codes.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------- legacy
# Only needed by scripts/migrate-legacy.ts when copying from the old cPanel MySQL.
LEGACY_MYSQL_HOST=""
LEGACY_MYSQL_PORT="3306"
LEGACY_MYSQL_USER=""
LEGACY_MYSQL_PASSWORD=""
LEGACY_MYSQL_DATABASE=""
